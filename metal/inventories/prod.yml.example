# Sanitized example of metal/inventories/prod.yml.
#
# This is the only inventory the documentation site inlines
# (docs/installation/production/configuration.md). Keep it free of real
# values: it is committed and published to homelab2.e-whisper.com.
# Your own metal/inventories/prod.yml is never part of the docs build.
all:
  vars:
    control_plane_endpoint: 192.0.2.100
    load_balancer_ip_pool:
      - 192.0.2.32/27
    # Site ULA (RFC 4193): pick your own random 40-bit global ID.
    # k3s cluster-cidr and Cilium clusterPoolIPv6PodCIDRList must use the same
    # pool, so it is defined once here and shared by both roles.
    dualstack_ipv6_pod_cidr: "fd00:1:2:3:4200::/56"       # Pod IPv6（每节点 /64）
    dualstack_ipv6_service_cidr: "fd00:1:2:3:4300::/112"  # Service IPv6
    ntp_server: "ntp.ubuntu.com"
    # Used for tailscale k8s node
    tailscale_auth_key: "tskey-auth-REPLACE_ME"
    # Used for tailscale-operator
    tailscale_client_id: "REPLACE_ME"
    tailscale_client_secret: "tskey-client-REPLACE_ME"
    registries_config_yaml: |
      mirrors:
        "*":
        docker.io:
          endpoint:
            - "https://registry.cn-hangzhou.aliyuncs.com"
metal:
  children:
    masters:
      hosts:
        node-0:
          ansible_host: 192.0.2.101
          mac: "aa:bb:cc:dd:ee:01"
          disk: nvme0n1
          network_interface: enp3s0
        node-1:
          ansible_host: 192.0.2.102
          mac: "aa:bb:cc:dd:ee:02"
          disk: nvme0n1
          network_interface: enp3s0
        node-2:
          ansible_host: 192.0.2.103
          mac: "aa:bb:cc:dd:ee:03"
          disk: nvme0n1
          network_interface: enp3s0
    workers:
      hosts:
        worker-0:
          ansible_host: 192.0.2.104
          mac: "aa:bb:cc:dd:ee:04"
          disk: nvme0n1
          network_interface: enp2s0
