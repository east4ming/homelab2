# 操作者提供的真实值（示例）。不要直接改这个文件，而是复制成同目录的
# zz-secrets.yml —— 后者已被 metal/inventories/.gitignore 忽略。
#
#   cp metal/inventories/group_vars/all/zz-secrets.yml.example \
#      metal/inventories/group_vars/all/zz-secrets.yml
#   chmod 600 metal/inventories/group_vars/all/zz-secrets.yml
#
# 这些变量覆盖 group_vars/all.yml 里的占位值。任一变量仍是占位串（REPLACE_ME 或
# 它自己的旧占位值）时，cluster.yml / boot.yml 会在写任何配置之前 fail 并列出缺什么。
# 背景见 metal/README.md「操作者必须提供的值」。

# ── 节点私有仓库 / 镜像源配置：整份 /etc/rancher/k3s/registries.yaml ──────────────
# ⚠️ 这是【整体覆盖】，不是合并。生产节点上该文件含数个 mirror 与 registry auth，
#    必须原样取回，不能凭记忆手写：
#
#   ssh casey@192.168.3.226 'sudo cat /etc/rancher/k3s/registries.yaml'
#
# 然后把输出原样粘贴到下面（保留缩进）。改成占位内容会把线上非 docker.io 的镜像源
# 与私有仓库认证全部抹掉。
registries_config_yaml: |
  mirrors:
    docker.io:
      endpoint:
        - "https://registry.cn-hangzhou.aliyuncs.com"

# ── Tailscale ────────────────────────────────────────────────────────────────
# auth key：一次性/可复用 pre-auth key，用于节点入网（boot.yml 的 cloud-init）。
#   生成：Tailscale 管理台 → Settings → Keys → Generate auth key
tailscale_auth_key: "tskey-auth-..."

# OAuth client：tailscale-operator 用它在 tailnet 里创建 ingress/proxy 资源。
#   生成：Tailscale 管理台 → Settings → OAuth clients（需 Devices: write 权限）
#   ⚠️ client_secret 只在创建时显示一次，且 /etc/kubernetes 里没有备份。
#   轮换步骤见 metal/README.md。
tailscale_client_id: "REPLACE_ME"
tailscale_client_secret: "tskey-client-..."

# ── 节点网卡 MAC（PXE / Wake-on-LAN 用）───────────────────────────────────────
# 键是 inventory 里的 hostname，值是【小写、冒号分隔】的待唤醒/装机网卡 MAC。
# 用 ip link show <iface> 或路由器 DHCP 表确认。prod 与 stag 的 hostname 都要给
# （只跑 prod 时下面 stag 两行可以删掉）。
metal_macs:
  n100-jumper-0: "aa:bb:cc:00:00:01"
  n100-jumper-1: "aa:bb:cc:00:00:02"
  n100-jumper-2: "aa:bb:cc:00:00:03"
  n100-cheshi-0: "aa:bb:cc:00:00:04"
  homelab-dev-master: "aa:bb:cc:00:00:05"
  homelab-dev-node: "aa:bb:cc:00:00:06"
