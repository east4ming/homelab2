#!/bin/bash
# Run the one-time tool install inside the running DSH container.
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"
NAMESPACE="${NAMESPACE:-deepseek-harness}"
POD="${POD:-$(kubectl -n "$NAMESPACE" get pod \
  -l app.kubernetes.io/name=deepseek-harness \
  -o jsonpath='{.items[0].metadata.name}' 2>/dev/null || true)}"

if [ -z "$POD" ]; then
  echo "ERROR: no deepseek-harness Pod found in namespace $NAMESPACE" >&2
  exit 1
fi

kubectl -n "$NAMESPACE" wait --for=condition=Ready "pod/$POD" --timeout=300s
kubectl -n "$NAMESPACE" cp "$REPO_ROOT/apps/deepseek-harness/files/install-tools.sh" \
  "$POD:/tmp/install-tools.sh"
kubectl -n "$NAMESPACE" exec -i "$POD" -- bash /tmp/install-tools.sh
