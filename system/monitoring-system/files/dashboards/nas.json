    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Volume usage. NASVolumeSpaceLow fires above 85%, NASVolumeSpaceCritical above 95%.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Volume"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              },
              {
                "id": "unit",
                "value": "string"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "id": 8,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Used %"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * (1 - node_filesystem_avail_bytes{job=\"nas-node\",mountpoint=~\"/share/.+\",fstype!~\"fuse|squashfs\"} / node_filesystem_size_bytes{job=\"nas-node\",mountpoint=~\"/share/.+\",fstype!~\"fuse|squashfs\"})",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Volume usage",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "device": true,
              "device_error": true,
              "fstype": true,
              "instance": true,
              "job": true,
              "nas": true
            },
            "indexByName": {},
            "renameByName": {
              "Value": "Used %",
              "mountpoint": "Volume"
            }
          }
        }
      ],
      "type": "table"
    },
